{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Event service settings",
  "type": "object",
  "properties": {
    "ChannelDetectors": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z0-9_-]{1,64}$" },
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "enum": ["MotionRegion", "LineDetector", "LineCounting", "FieldDetector",
                   "LicensePlateRecognition", "FaceRecognition", "MotionAlarm", "CellMotion", "AudioDetection"]
        },
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "Enabled": { "$ref": "types.schema.json#/$defs/boolean" },
            "AutoGenerateEvents": { "$ref": "types.schema.json#/$defs/boolean" },
            "EventGenerationTimeout": { "$ref": "types.schema.json#/$defs/positiveInteger" }
          }
        }
      }
    },
    "Namespaces": {
      "$ref": "types.schema.json#/$defs/namespaces"
    },
    "GetEventProperties": {
      "type": "object",
      "properties": {
        "ReadResponseFromFile": {
          "$ref": "types.schema.json#/$defs/boolean"
        },
        "ResponseFilePath": {
          "$ref": "types.schema.json#/$defs/token"
        }
      },
      "required": [
        "ReadResponseFromFile",
        "ResponseFilePath"
      ],
      "additionalProperties": false
    },
    "PullPoint": {
      "type": "object",
      "properties": {
        "IgnoreClientsTimeout": {
          "$ref": "types.schema.json#/$defs/boolean",
          "description": "Currently ignored; configured Timeout is always used."
        },
        "Timeout": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            {
              "type": "string",
              "pattern": "^[0-9]+$"
            }
          ]
        },
        "UseHttpServerPort": {
          "$ref": "types.schema.json#/$defs/boolean"
        },
        "Port": {
          "$ref": "types.schema.json#/$defs/listeningPort"
        }
      },
      "required": [
        "Timeout",
        "UseHttpServerPort",
        "Port"
      ],
      "additionalProperties": false
    },
    "DigitalInputsAlarm": {
      "type": "object",
      "properties": {
        "Topic": {
          "$ref": "types.schema.json#/$defs/token"
        },
        "EventGenerationTimeout": {
          "$ref": "#/$defs/interval"
        },
        "Enabled": {
          "$ref": "types.schema.json#/$defs/boolean"
        },
        "AutoGenerateEvents": {
          "$ref": "types.schema.json#/$defs/boolean"
        }
      },
      "required": [
        "Topic",
        "EventGenerationTimeout"
      ],
      "additionalProperties": false
    },
    "MotionAlarm": {
      "type": "object",
      "properties": {
        "Topic": {
          "$ref": "types.schema.json#/$defs/token"
        },
        "EventGenerationTimeout": {
          "$ref": "#/$defs/interval"
        },
        "Source": {
          "$ref": "types.schema.json#/$defs/token"
        },
        "Enabled": {
          "$ref": "types.schema.json#/$defs/boolean"
        },
        "AutoGenerateEvents": {
          "$ref": "types.schema.json#/$defs/boolean"
        }
      },
      "required": [
        "Topic",
        "EventGenerationTimeout",
        "Source"
      ],
      "additionalProperties": false
    },
    "CellMotion": {
      "type": "object",
      "properties": {
        "Topic": {
          "$ref": "types.schema.json#/$defs/token"
        },
        "EventGenerationTimeout": {
          "$ref": "#/$defs/interval"
        },
        "VideoSourceConfigurationToken": {
          "$ref": "types.schema.json#/$defs/token"
        },
        "VideoAnalyticsConfigurationToken": {
          "$ref": "types.schema.json#/$defs/token"
        },
        "Rule": {
          "$ref": "types.schema.json#/$defs/token"
        },
        "DataItemName": {
          "$ref": "types.schema.json#/$defs/token"
        },
        "Enabled": {
          "$ref": "types.schema.json#/$defs/boolean"
        },
        "AutoGenerateEvents": {
          "$ref": "types.schema.json#/$defs/boolean"
        }
      },
      "required": [
        "Topic",
        "EventGenerationTimeout",
        "VideoSourceConfigurationToken",
        "VideoAnalyticsConfigurationToken",
        "Rule",
        "DataItemName"
      ],
      "additionalProperties": false
    },
    "AudioDetection": {
      "type": "object",
      "properties": {
        "Topic": {
          "$ref": "types.schema.json#/$defs/token"
        },
        "EventGenerationTimeout": {
          "$ref": "#/$defs/interval"
        },
        "SourceConfigurationToken": {
          "$ref": "types.schema.json#/$defs/token"
        },
        "AnalyticsConfigurationToken": {
          "$ref": "types.schema.json#/$defs/token"
        },
        "Rule": {
          "$ref": "types.schema.json#/$defs/token"
        },
        "DataItemName": {
          "$ref": "types.schema.json#/$defs/token"
        },
        "Enabled": {
          "$ref": "types.schema.json#/$defs/boolean"
        },
        "AutoGenerateEvents": {
          "$ref": "types.schema.json#/$defs/boolean"
        }
      },
      "required": [
        "Topic",
        "EventGenerationTimeout",
        "SourceConfigurationToken",
        "AnalyticsConfigurationToken",
        "Rule",
        "DataItemName"
      ],
      "additionalProperties": false
    },
    "MotionRegion": {
      "type": "object",
      "properties": {
        "EventGenerationTimeout": {
          "$ref": "#/$defs/interval"
        },
        "Enabled": {
          "$ref": "types.schema.json#/$defs/boolean"
        },
        "AutoGenerateEvents": {
          "$ref": "types.schema.json#/$defs/boolean"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "LineDetector": {
      "type": "object",
      "properties": {
        "EventGenerationTimeout": {
          "$ref": "#/$defs/interval"
        },
        "Enabled": {
          "$ref": "types.schema.json#/$defs/boolean"
        },
        "AutoGenerateEvents": {
          "$ref": "types.schema.json#/$defs/boolean"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "LineCounting": {
      "type": "object",
      "properties": {
        "EventGenerationTimeout": {
          "$ref": "#/$defs/interval"
        },
        "Enabled": {
          "$ref": "types.schema.json#/$defs/boolean"
        },
        "AutoGenerateEvents": {
          "$ref": "types.schema.json#/$defs/boolean"
        }
      },
      "additionalProperties": false
    },
    "FieldDetector": {
      "type": "object",
      "properties": {
        "EventGenerationTimeout": {
          "$ref": "#/$defs/interval"
        },
        "Enabled": {
          "$ref": "types.schema.json#/$defs/boolean"
        },
        "AutoGenerateEvents": {
          "$ref": "types.schema.json#/$defs/boolean"
        }
      },
      "additionalProperties": false
    },
    "LicensePlateRecognition": {
      "type": "object",
      "properties": {
        "EventGenerationTimeout": {
          "$ref": "#/$defs/interval"
        },
        "Enabled": {
          "$ref": "types.schema.json#/$defs/boolean"
        },
        "AutoGenerateEvents": {
          "$ref": "types.schema.json#/$defs/boolean"
        }
      },
      "additionalProperties": false
    },
    "FaceRecognition": {
      "type": "object",
      "properties": {
        "EventGenerationTimeout": {
          "$ref": "#/$defs/interval"
        },
        "Enabled": {
          "$ref": "types.schema.json#/$defs/boolean"
        },
        "AutoGenerateEvents": {
          "$ref": "types.schema.json#/$defs/boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "Namespaces",
    "GetEventProperties",
    "PullPoint",
    "DigitalInputsAlarm",
    "MotionAlarm",
    "CellMotion",
    "AudioDetection"
  ],
  "additionalProperties": false,
  "$defs": {
    "interval": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        {
          "type": "string",
          "pattern": "^(?:[1-9][0-9]{0,8}|1[0-9]{9}|20[0-9]{8}|21[0-3][0-9]{7}|214[0-6][0-9]{6}|2147[0-3][0-9]{5}|21474[0-7][0-9]{4}|214748[0-2][0-9]{3}|2147483[0-5][0-9]{2}|21474836[0-3][0-9]|214748364[0-7])$"
        }
      ]
    }
  }
}
