{
    "loggingLevel":"DEBUG",
    "loggingOutput":"console",

    "addresses":
    {
        "ipv4":"0.0.0.0",
        "http_port":"8080",
        "https_port":"8443",
        "rtsp_port":"8554"
    },

    "advertised":
    {
        "ipv4":"127.0.0.1",
        "web_scheme":"auto",
        "http_port":0,
        "https_port":0,
        "rtsp_port":0,
        "pullpoint_port":0
    },

    "http": { "enabled": true },
    "https": { "enabled": true, "certificate": "", "private_key": "" },

    "rtp":
    {
        "port_min":50000,
        "port_max":50199
    },

    "rtsp_metadata": { "enabled": true },

    "authenticationMethods":
    [
        "none",
        "ws-security",
        "digest",
        "digest/ws-security"
    ],

    "authentication":"digest/ws-security",

    "portForwardingSimulation":
    {
        "enabled_for_http":false,
        "http_port":1080,
        "enabled_for_rtsp":false,
        "rtsp_port":1554
    },
	
	"networkDelaySimulation":
	{
		"milliseconds":0
	},

    "fileStreaming":
    {
        "description":"use a file for RTSP streaming",
        "enabled":false,
        "filePath":""
    }
}